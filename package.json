{
  "name": "one-dark-modern",
  "displayName": "One Dark Modern",
  "description": "A color theme inspired by Atom One Dark and Dark Modern",
  "version": "0.1.3",
  "publisher": "hn-11",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hn-11/one-dark-modern.git"
  },
  "bugs": {
    "url": "https://github.com/hn-11/one-dark-modern/issues"
  },
  "homepage": "https://github.com/hn-11/one-dark-modern#readme",
  "keywords": [
    "theme",
    "color-theme",
    "one dark",
    "atom",
    "dark modern",
    "jetbrains"
  ],
  "scripts": {
    "build": "node scripts/build.ts && node scripts/build-jetbrains.ts && node scripts/build-ghostty.ts && node scripts/build-windows-terminal.ts && node scripts/build-vim.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "audit": "node scripts/audit-flicker.ts",
    "audit:contrast": "node scripts/audit-contrast.ts",
    "audit:artifacts": "node scripts/audit-artifacts.ts",
    "version": "npm run build && git add themes",
    "postversion": "git push origin main --tags",
    "oracle": "node scripts/oracle.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vscode/vsce": "^3.9.2",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "web-tree-sitter": "^0.26.12"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=23.6.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "One Dark Modern",
        "uiTheme": "vs-dark",
        "path": "./themes/one-dark-modern-color-theme.json"
      },
      {
        "label": "One Dark 2026",
        "uiTheme": "vs-dark",
        "path": "./themes/one-dark-2026-color-theme.json"
      }
    ]
  }
}
